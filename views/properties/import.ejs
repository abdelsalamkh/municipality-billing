<% layout('layouts/main') %>

<div class="card">

<div class="card-header">
    استيراد العقارات من Excel
</div>

<div class="card-body">

<form method="POST"
      action="/properties/import"
      enctype="multipart/form-data">


<label class="form-label">
اختر ملف Excel
</label>

<input 
type="file"
name="excel"
class="form-control"
accept=".xlsx,.xls"
required>


<button class="btn btn-success mt-3">
استيراد
</button>


</form>

</div>

</div>