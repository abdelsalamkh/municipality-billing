<!DOCTYPE html>

<html lang="ar" dir="rtl">

<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1">

<title>التحقق من الفاتورة</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet">

</head>

<body class="bg-light">

<div class="container py-5">

<div class="row justify-content-center">

<div class="col-lg-6">

<div class="card shadow">

<div class="card-header text-center bg-primary text-white">

<h4>

التحقق من الفاتورة

</h4>

</div>

<div class="card-body">

<form method="POST">

<label class="form-label">

رمز الفاتورة

</label>

<input
name="billCode"
class="form-control mb-3"
placeholder="مثال: MH-K8P2X4QW"
required>

<button class="btn btn-primary w-100">

بحث

</button>

</form>

<% if(error){ %>

<div class="alert alert-danger mt-4">

<%= error %>

</div>

<% } %>

<% if(bill){ %>

<hr>

<table class="table">

<tr>

<th>رقم الفاتورة</th>

<td><%= bill.billNumber %></td>

</tr>

<tr>

<th>العقار</th>

<td><%= bill.propertyCode %></td>

</tr>

<tr>

<th>المشترك</th>

<td><%= bill.occupant %></td>

</tr>

<tr>

<th>الحي</th>

<td><%= bill.neighborhood %></td>

</tr>

<tr>

<th>النوع</th>

<td>

<%= bill.billType=="Water"
? "مياه 💧"
: "نفايات 🗑️" %>

</td>

</tr>

<tr>

<th>الشهر</th>

<td><%= bill.month %></td>

</tr>

<tr>

<th>السنة</th>

<td><%= bill.year %></td>

</tr>

<tr>

<th>المبلغ</th>

<td>

<%= bill.amount %> $

</td>

</tr>

<tr>

<th>الحالة</th>

<td>

<% if(bill.status=="Paid"){ %>

<span class="badge bg-success">

مدفوعة

</span>

<% }else{ %>

<span class="badge bg-danger">

غير مدفوعة

</span>

<% } %>

</td>

</tr>

<% if(bill.paymentDate){ %>

<tr>

<th>تاريخ الدفع</th>

<td>

<%= new Date(bill.paymentDate).toLocaleDateString('ar-LB') %>

</td>

</tr>

<tr>
    <th>استلم الدفعة</th>
    <td>
        <%= bill.receivedByName || '-' %>
    </td>
</tr>

<% } %>

</table>

<% } %>

</div>

</div>

</div>

</div>

</div>

</body>

</html>